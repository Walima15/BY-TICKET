# ---------------------------------------------------------------------------
# BY Tickets — environment template
# Copy to `apps/web/.env.local` (or run `npm run secrets` from the repo root, which
# copies this file and fills in generated secrets). Never commit `.env.local`.
# The contract deploy script writes contract IDs into the same file.
#
# NEXT_PUBLIC_* values are inlined into browser JavaScript: NEVER put secrets in them.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="BY Tickets"

# --- Supabase (Phase 3) ----------------------------------------------------
# Project Settings → API Keys. Legacy anon / service_role keys also work here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS — use only in trusted server code.
SUPABASE_SECRET_KEY=

# --- Stellar network -------------------------------------------------------
# testnet | public
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract IDs (C...). Filled automatically by `npm run contracts:deploy`.
NEXT_PUBLIC_EVENT_TICKET_CONTRACT_ID=
NEXT_PUBLIC_REWARDS_CONTRACT_ID=
NEXT_PUBLIC_BADGE_CONTRACT_ID=
# Contract admin account (public key only; the secret stays in the Stellar CLI keystore).
NEXT_PUBLIC_STELLAR_ADMIN_PUBLIC_KEY=

# Settlement asset. On testnet the deploy script can create a mock USDC; or use
# Circle's testnet USDC and its Stellar Asset Contract ID.
NEXT_PUBLIC_USDC_ASSET_CODE=USDC
NEXT_PUBLIC_USDC_ISSUER=
NEXT_PUBLIC_USDC_CONTRACT_ID=

# Server only. Platform account: sponsors fees/reserves for custodial users and
# receives the platform fee. Testnet: `npm run secrets -- --fund` generates and
# funds one via Friendbot. Mainnet: use a KMS, not this variable.
STELLAR_PLATFORM_SECRET=
NEXT_PUBLIC_STELLAR_PLATFORM_PUBLIC_KEY=

# --- Custodial wallets (email-login users) ----------------------------------
# Server only. 32 random bytes, base64. AES-256-GCM key for encrypting custodial secrets.
CUSTODIAL_KEY_ENCRYPTION_KEY=

# --- Ticket QR credentials (Phase 5) ---------------------------------------
# Ed25519 key pair (base64url, raw 32 bytes). Private key: server only.
QR_CREDENTIAL_SIGNING_KEY=
NEXT_PUBLIC_QR_CREDENTIAL_PUBLIC_KEY=
# Seconds a rendered QR stays valid (anti-screenshot window).
NEXT_PUBLIC_QR_ROTATION_SECONDS=20

# --- Pricing & fees ----------------------------------------------------------
# Fallback display rate until an FX provider is wired in.
NEXT_PUBLIC_ZMW_PER_USDC=26.5
# Platform fee in basis points (250 = 2.5%). Mirrored on-chain at deploy.
PLATFORM_FEE_BPS=250

# --- Mobile money ramp -------------------------------------------------------
# stub | mtn_momo | airtel_money | zamtel_kwacha  (only `stub` is implemented)
PAYMENT_RAMP_PROVIDER=stub

# --- Rate limiting (optional; in-memory fallback when empty) -----------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin bootstrap ---------------------------------------------------------
# Comma-separated emails that get the admin role on first sign-in.
ADMIN_EMAILS=
